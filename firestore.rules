rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function ownsFolder(folderId) {
      return folderId == null
        || (
          folderId is string
          && folderId.size() <= 128
          && exists(/databases/$(database)/documents/folders/$(folderId))
          && get(/databases/$(database)/documents/folders/$(folderId)).data.userId == request.auth.uid
        );
    }

    function isFounder() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'founder';
    }

    function isValidUserProfile(data, userId) {
      return data.uid == userId
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 120
        && data.handle is string && data.handle.size() > 0 && data.handle.size() <= 40
        && data.handle.matches('^[a-z0-9][a-z0-9_-]*$')
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 500))
        && (!('role' in data) || data.role in ['founder', 'creator', 'member'])
        && (!('status' in data) || data.status in ['active', 'hidden', 'blocked'])
        && (!('stats' in data) || data.stats is map);
    }

    // Basic validation helper for prompt format
    function isValidPrompt(data) {
      return data.userId == request.auth.uid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 150
        && data.promptText is string && data.promptText.size() > 0 && data.promptText.size() <= 10000
        && data.category is string && data.category.size() <= 50
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 10))
        && (!('isFavorite' in data) || data.isFavorite is bool)
        && (!('notas' in data) || (data.notas is string && data.notas.size() <= 6000))
        && (!('isShared' in data) || data.isShared is bool)
        && (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 200))
        && (!('authorAvatar' in data) || (data.authorAvatar is string && data.authorAvatar.size() <= 1000))
        && (!('authorHandle' in data) || (data.authorHandle is string && data.authorHandle.size() <= 40))
        && (!('likedBy' in data) || (data.likedBy is list && data.likedBy.size() <= 1000))
        && (!('likesCount' in data) || data.likesCount is int)
        && (!('forkedFrom' in data) || (data.forkedFrom is string && data.forkedFrom.size() <= 200))
        && (!('forkedFromPromptId' in data) || (data.forkedFromPromptId is string && data.forkedFromPromptId.size() <= 128))
        && (!('forkedFromUserId' in data) || (data.forkedFromUserId is string && data.forkedFromUserId.size() <= 128))
        && (!('forkedFromAuthorName' in data) || (data.forkedFromAuthorName is string && data.forkedFromAuthorName.size() <= 200))
        && (!('forkedFromAuthorHandle' in data) || (data.forkedFromAuthorHandle is string && data.forkedFromAuthorHandle.size() <= 40))
        && (!('forkedFromTitle' in data) || (data.forkedFromTitle is string && data.forkedFromTitle.size() <= 200))
        && (!('suggestedVariables' in data) || data.suggestedVariables is list)
        && (!('folderId' in data) || ownsFolder(data.folderId));
    }

    function isValidCommunityPost(data) {
      return data.type in ['idea', 'question', 'team', 'showcase']
        && data.title is string && data.title.size() > 0 && data.title.size() <= 140
        && data.body is string && data.body.size() > 0 && data.body.size() <= 4000
        && data.tags is list && data.tags.size() <= 12
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000))
        && (!('linkUrl' in data) || (data.linkUrl is string && data.linkUrl.size() <= 1000))
        && data.authorUid is string && data.authorUid.size() <= 128
        && data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 200
        && (!('authorHandle' in data) || (data.authorHandle is string && data.authorHandle.size() <= 40))
        && (!('authorAvatar' in data) || (data.authorAvatar is string && data.authorAvatar.size() <= 1000))
        && data.likesCount is int && data.likesCount >= 0
        && data.likedBy is list && data.likedBy.size() <= 1000
        && data.keys().hasOnly(['type', 'title', 'body', 'tags', 'imageUrl', 'linkUrl', 'authorUid', 'authorName', 'authorHandle', 'authorAvatar', 'likesCount', 'likedBy', 'createdAt', 'updatedAt']);
    }

    function isValidCommunityPostComment(data, postId) {
      return data.postId == postId
        && data.userId == request.auth.uid
        && data.userName is string && data.userName.size() > 0 && data.userName.size() <= 200
        && (!('userAvatar' in data) || (data.userAvatar is string && data.userAvatar.size() <= 1000))
        && data.text is string && data.text.size() > 0 && data.text.size() <= 1000
        && data.createdAt == request.time
        && data.keys().hasOnly(['postId', 'userId', 'userName', 'userAvatar', 'text', 'createdAt']);
    }

    function isValidConnection(data, ownerUid, targetUid) {
      return data.ownerUid == ownerUid
        && data.targetUid == targetUid
        && data.targetName is string && data.targetName.size() > 0 && data.targetName.size() <= 200
        && (!('targetAvatar' in data) || (data.targetAvatar is string && data.targetAvatar.size() <= 1000))
        && (!('targetHandle' in data) || (data.targetHandle is string && data.targetHandle.size() <= 40))
        && data.status in ['pending_sent', 'pending_received', 'connected']
        && data.requestedBy is string && data.requestedBy.size() <= 128
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.keys().hasOnly(['ownerUid', 'targetUid', 'targetName', 'targetAvatar', 'targetHandle', 'status', 'requestedBy', 'createdAt', 'updatedAt']);
    }

    function isConnectionParticipant(userId, connectionId) {
      return isSignedIn() && (request.auth.uid == userId || request.auth.uid == connectionId);
    }

    function preservesConnectionIdentity() {
      return incoming().ownerUid == existing().ownerUid
        && incoming().targetUid == existing().targetUid
        && incoming().targetName == existing().targetName
        && incoming().targetAvatar == existing().targetAvatar
        && incoming().targetHandle == existing().targetHandle
        && incoming().requestedBy == existing().requestedBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
    }

    function isChatParticipant(data) {
      return isSignedIn()
        && data.participants is list
        && data.participants.size() == 2
        && request.auth.uid in data.participants;
    }

    function isConnectedTo(targetUid) {
      return isSignedIn()
        && targetUid is string
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/connections/$(targetUid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/connections/$(targetUid)).data.status == 'connected'
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blockedUsers/$(targetUid))
        && !exists(/databases/$(database)/documents/users/$(targetUid)/blockedUsers/$(request.auth.uid));
    }

    function isValidChatThread(data) {
      return isChatParticipant(data)
        && data.participantNames is map
        && data.participantHandles is map
        && data.participantAvatars is map
        && (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 1000))
        && (!('lastMessageSenderUid' in data) || data.lastMessageSenderUid in data.participants)
        && (!('lastMessageAt' in data) || data.lastMessageAt == request.time)
        && data.updatedAt == request.time
        && data.keys().hasOnly(['participants', 'participantNames', 'participantHandles', 'participantAvatars', 'lastMessage', 'lastMessageSenderUid', 'lastMessageAt', 'createdAt', 'updatedAt']);
    }

    function isValidChatMessage(data, chatId) {
      return data.chatId == chatId
        && data.senderUid == request.auth.uid
        && data.recipientUid is string
        && data.recipientUid != request.auth.uid
        && isConnectedTo(data.recipientUid)
        && data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 200
        && (!('senderAvatar' in data) || (data.senderAvatar is string && data.senderAvatar.size() <= 1000))
        && data.text is string && data.text.size() > 0 && data.text.size() <= 1000
        && data.createdAt == request.time
        && data.keys().hasOnly(['chatId', 'senderUid', 'senderName', 'senderAvatar', 'recipientUid', 'text', 'createdAt']);
    }

    function isValidBlockedUser(data, targetUid) {
      return data.targetUid == targetUid
        && data.targetName is string && data.targetName.size() > 0 && data.targetName.size() <= 200
        && (!('targetHandle' in data) || (data.targetHandle is string && data.targetHandle.size() <= 40))
        && (!('reason' in data) || (data.reason is string && data.reason.size() <= 120))
        && data.createdAt == request.time
        && data.keys().hasOnly(['targetUid', 'targetName', 'targetHandle', 'reason', 'createdAt']);
    }

    function isValidChatReport(data) {
      return data.reporterUid == request.auth.uid
        && data.reportedUid is string
        && data.reportedUid != request.auth.uid
        && data.reason is string && data.reason.size() > 0 && data.reason.size() <= 120
        && data.createdAt == request.time
        && data.keys().hasOnly(['reporterUid', 'reportedUid', 'reason', 'createdAt']);
    }

    function isValidHackathon(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && data.description is string && data.description.size() > 0 && data.description.size() <= 2500
        && data.url is string && data.url.size() > 0 && data.url.size() <= 1000
        && data.deadline is string && data.deadline.size() <= 40
        && data.mode is string && data.mode.size() > 0 && data.mode.size() <= 40
        && data.tags is list && data.tags.size() <= 12
        && data.rolesNeeded is list && data.rolesNeeded.size() <= 8
        && data.authorUid == request.auth.uid
        && (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 200))
        && (!('authorHandle' in data) || (data.authorHandle is string && data.authorHandle.size() <= 40))
        && data.keys().hasOnly(['title', 'description', 'url', 'deadline', 'mode', 'tags', 'rolesNeeded', 'authorUid', 'authorName', 'authorHandle', 'createdAt', 'updatedAt']);
    }

    function isValidSavedIdea(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 180
        && data.summary is string && data.summary.size() > 0 && data.summary.size() <= 1200
        && data.url is string && data.url.size() > 0 && data.url.size() <= 1000
        && data.source is string && data.source.size() > 0 && data.source.size() <= 120
        && data.language in ['en', 'es', 'unknown']
        && data.category in ['ai', 'tech', 'startups', 'devtools', 'design', 'hackathons']
        && data.tags is list && data.tags.size() <= 12
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000))
        && data.createdFrom in ['news', 'hackathon', 'manual']
        && data.savedAt == request.time
        && data.keys().hasOnly(['title', 'summary', 'url', 'source', 'language', 'category', 'tags', 'imageUrl', 'savedAt', 'createdFrom']);
    }

    function isValidBriefing(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 180
        && data.intro is string && data.intro.size() > 0 && data.intro.size() <= 1000
        && data.items is list && data.items.size() > 0 && data.items.size() <= 8
        && data.tags is list && data.tags.size() <= 12
        && data.language in ['en', 'es', 'unknown', 'all']
        && (!('stats' in data) || isValidBriefingStats(data.stats))
        && data.authorUid == request.auth.uid
        && data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 200
        && (!('authorHandle' in data) || (data.authorHandle is string && data.authorHandle.size() <= 40))
        && data.isPublished is bool
        && data.keys().hasOnly(['title', 'intro', 'items', 'tags', 'language', 'stats', 'authorUid', 'authorName', 'authorHandle', 'isPublished', 'createdAt', 'updatedAt']);
    }

    function isValidBriefingStats(stats) {
      return stats is map
        && (!('opens' in stats) || (stats.opens is int && stats.opens >= 0))
        && (!('linkCopies' in stats) || (stats.linkCopies is int && stats.linkCopies >= 0))
        && (!('ideaSaves' in stats) || (stats.ideaSaves is int && stats.ideaSaves >= 0))
        && (!('promptCreates' in stats) || (stats.promptCreates is int && stats.promptCreates >= 0))
        && (!('forumPosts' in stats) || (stats.forumPosts is int && stats.forumPosts >= 0))
        && stats.keys().hasOnly(['opens', 'linkCopies', 'ideaSaves', 'promptCreates', 'forumPosts']);
    }

    match /briefings/{briefingId} {
      allow get: if existing().isPublished == true || isFounder() || (isSignedIn() && existing().authorUid == request.auth.uid);
      allow list: if resource.data.isPublished == true || isFounder() || (isSignedIn() && resource.data.authorUid == request.auth.uid);

      allow create: if isSignedIn()
        && isValidId(briefingId)
        && incoming().authorUid == request.auth.uid
        && isValidBriefing(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(briefingId)
        && (
          (
            existing().authorUid == request.auth.uid
            && incoming().authorUid == existing().authorUid
            && incoming().authorName == existing().authorName
            && incoming().authorHandle == existing().authorHandle
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && isValidBriefing(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'intro', 'items', 'tags', 'language', 'isPublished', 'stats', 'updatedAt'])
          )
          ||
          (
            existing().isPublished == true
            && incoming().title == existing().title
            && incoming().intro == existing().intro
            && incoming().items == existing().items
            && incoming().tags == existing().tags
            && incoming().language == existing().language
            && incoming().authorUid == existing().authorUid
            && incoming().authorName == existing().authorName
            && incoming().authorHandle == existing().authorHandle
            && incoming().isPublished == existing().isPublished
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && isValidBriefing(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly(['stats', 'updatedAt'])
          )
        );

      allow delete: if isSignedIn() && existing().authorUid == request.auth.uid;
    }

    match /communityPosts/{postId} {
      allow get, list: if true;

      allow create: if isSignedIn()
        && isValidId(postId)
        && isValidCommunityPost(incoming())
        && incoming().likesCount == 0
        && incoming().likedBy.size() == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(postId)
        && (
          (
            existing().authorUid == request.auth.uid
            && incoming().authorUid == existing().authorUid
            && incoming().authorName == existing().authorName
            && incoming().authorHandle == existing().authorHandle
            && incoming().authorAvatar == existing().authorAvatar
            && incoming().likedBy == existing().likedBy
            && incoming().likesCount == existing().likesCount
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && isValidCommunityPost(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly(['type', 'title', 'body', 'tags', 'imageUrl', 'linkUrl', 'updatedAt'])
          )
          ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['likedBy', 'likesCount', 'updatedAt'])
            && incoming().updatedAt == request.time
            && incoming().likedBy is list
            && incoming().likedBy.size() <= 1000
            && incoming().likesCount is int
            && incoming().likesCount == incoming().likedBy.size()
            && (
              (
                !(request.auth.uid in existing().likedBy)
                && request.auth.uid in incoming().likedBy
                && incoming().likedBy.size() == existing().likedBy.size() + 1
                && incoming().likedBy.hasAll(existing().likedBy)
              )
              ||
              (
                request.auth.uid in existing().likedBy
                && !(request.auth.uid in incoming().likedBy)
                && incoming().likedBy.size() == existing().likedBy.size() - 1
                && existing().likedBy.hasAll(incoming().likedBy)
              )
            )
          )
        );

      allow delete: if isSignedIn()
        && existing().authorUid == request.auth.uid;

      match /comments/{commentId} {
        allow get, list: if true;

        allow create: if isSignedIn()
          && isValidId(commentId)
          && exists(/databases/$(database)/documents/communityPosts/$(postId))
          && isValidCommunityPostComment(incoming(), postId);

        allow update: if false;

        allow delete: if isSignedIn()
          && (
            existing().userId == request.auth.uid
            || get(/databases/$(database)/documents/communityPosts/$(postId)).data.authorUid == request.auth.uid
          );
      }
    }

    match /hackathons/{hackathonId} {
      allow get, list: if true;

      allow create: if isSignedIn()
        && isValidId(hackathonId)
        && isValidHackathon(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(hackathonId)
        && existing().authorUid == request.auth.uid
        && incoming().authorUid == existing().authorUid
        && incoming().authorName == existing().authorName
        && incoming().authorHandle == existing().authorHandle
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isValidHackathon(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'url', 'deadline', 'mode', 'tags', 'rolesNeeded', 'updatedAt']);

      allow delete: if isSignedIn()
        && existing().authorUid == request.auth.uid;
    }

    match /chats/{chatId} {
      allow get, list: if isChatParticipant(resource.data);

      allow create: if isSignedIn()
        && isValidId(chatId)
        && isValidChatThread(incoming())
        && incoming().createdAt == request.time
        && (!('lastMessageSenderUid' in incoming()) || incoming().lastMessageSenderUid == request.auth.uid)
        && isConnectedTo(incoming().participants[0] == request.auth.uid ? incoming().participants[1] : incoming().participants[0]);

      allow update: if isSignedIn()
        && isValidId(chatId)
        && isChatParticipant(existing())
        && isValidChatThread(incoming())
        && incoming().participants == existing().participants
        && incoming().createdAt == existing().createdAt
        && incoming().lastMessageSenderUid == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['participantNames', 'participantHandles', 'participantAvatars', 'lastMessage', 'lastMessageSenderUid', 'lastMessageAt', 'updatedAt'])
        && isConnectedTo(incoming().participants[0] == request.auth.uid ? incoming().participants[1] : incoming().participants[0]);

      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if isSignedIn()
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        allow create: if isSignedIn()
          && isValidId(messageId)
          && request.auth.uid in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && incoming().recipientUid in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && isValidChatMessage(incoming(), chatId);

        allow update, delete: if false;
      }

      match /reports/{reporterId} {
        allow get, list: if isFounder()
          || (isSignedIn() && reporterId == request.auth.uid);

        allow create: if isSignedIn()
          && reporterId == request.auth.uid
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && incoming().reportedUid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && isValidChatReport(incoming());

        allow update, delete: if false;
      }
    }

    match /users/{userId} {
      allow get, list: if existing().status == 'active' || isFounder() || (isSignedIn() && request.auth.uid == userId);

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().role in ['creator', 'member']
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && existing().uid == userId
        && incoming().uid == existing().uid
        && incoming().role == existing().role
        && incoming().status == existing().status
        && incoming().createdAt == existing().createdAt
        && incoming().stats == existing().stats
        && incoming().updatedAt == request.time
        && isValidUserProfile(incoming(), userId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'handle', 'bio', 'updatedAt']);

      allow delete: if false;

      match /following/{creatorId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn()
          && request.auth.uid == userId
          && creatorId != userId
          && incoming().targetUid == creatorId
          && incoming().targetName is string && incoming().targetName.size() > 0 && incoming().targetName.size() <= 200
          && (!('targetAvatar' in incoming()) || (incoming().targetAvatar is string && incoming().targetAvatar.size() <= 1000))
          && incoming().createdAt == request.time;

        allow update: if false;

        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /connections/{connectionId} {
        allow get, list: if isFounder() || (isSignedIn() && request.auth.uid == userId);

        allow create: if isSignedIn()
          && isValidId(connectionId)
          && userId != connectionId
          && !exists(/databases/$(database)/documents/users/$(userId)/blockedUsers/$(connectionId))
          && !exists(/databases/$(database)/documents/users/$(connectionId)/blockedUsers/$(userId))
          && (
            (
              request.auth.uid == userId
              && incoming().status == 'pending_sent'
              && incoming().requestedBy == request.auth.uid
              && isValidConnection(incoming(), userId, connectionId)
            )
            ||
            (
              request.auth.uid == connectionId
              && incoming().status == 'pending_received'
              && incoming().requestedBy == request.auth.uid
              && isValidConnection(incoming(), userId, connectionId)
            )
          );

        allow update: if isConnectionParticipant(userId, connectionId)
          && incoming().status == 'connected'
          && preservesConnectionIdentity()
          && (
            (
              request.auth.uid == userId
              && existing().status == 'pending_received'
            )
            ||
            (
              request.auth.uid == connectionId
              && existing().status == 'pending_sent'
            )
          );

        allow delete: if isConnectionParticipant(userId, connectionId);
      }

      match /blockedUsers/{targetUid} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn()
          && request.auth.uid == userId
          && isValidId(targetUid)
          && targetUid != userId
          && isValidBlockedUser(incoming(), targetUid);

        allow update: if false;

        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /events/{eventId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn()
          && request.auth.uid == userId
          && isValidId(eventId)
          && incoming().type in ['recommendation_open', 'recommendation_use', 'recommendation_copy', 'use', 'copy', 'edit', 'briefing_open', 'briefing_link_copy', 'briefing_idea_save', 'briefing_prompt_create', 'briefing_forum_post']
          && (!('promptId' in incoming()) || incoming().promptId == null || (incoming().promptId is string && incoming().promptId.size() <= 128))
          && (!('promptTitle' in incoming()) || incoming().promptTitle == null || (incoming().promptTitle is string && incoming().promptTitle.size() <= 150))
          && (!('category' in incoming()) || incoming().category == null || (incoming().category is string && incoming().category.size() <= 50))
          && (!('tags' in incoming()) || (incoming().tags is list && incoming().tags.size() <= 10))
          && (!('metadata' in incoming()) || incoming().metadata is map)
          && incoming().createdAt == request.time;

        allow update, delete: if false;
      }

      match /savedIdeas/{ideaId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create, update: if isSignedIn()
          && request.auth.uid == userId
          && isValidId(ideaId)
          && isValidSavedIdea(incoming());

        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /favorites/{promptId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn()
          && request.auth.uid == userId
          && isValidId(promptId)
          && exists(/databases/$(database)/documents/prompts/$(promptId))
          && get(/databases/$(database)/documents/prompts/$(promptId)).data.isShared == true
          && incoming().promptId == promptId
          && incoming().promptTitle == get(/databases/$(database)/documents/prompts/$(promptId)).data.title
          && incoming().promptCategory == get(/databases/$(database)/documents/prompts/$(promptId)).data.category
          && incoming().promptAuthorUid == get(/databases/$(database)/documents/prompts/$(promptId)).data.userId
          && incoming().promptTitle is string && incoming().promptTitle.size() > 0 && incoming().promptTitle.size() <= 150
          && incoming().promptCategory is string && incoming().promptCategory.size() <= 50
          && incoming().promptAuthorUid is string && incoming().promptAuthorUid.size() <= 128
          && incoming().promptAuthorName is string && incoming().promptAuthorName.size() > 0 && incoming().promptAuthorName.size() <= 200
          && (!('promptAuthorHandle' in incoming()) || (incoming().promptAuthorHandle is string && incoming().promptAuthorHandle.size() <= 40))
          && incoming().createdAt == request.time;

        allow update: if false;

        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /hiddenPrompts/{promptId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn()
          && request.auth.uid == userId
          && isValidId(promptId)
          && incoming().promptId == promptId
          && incoming().promptTitle is string && incoming().promptTitle.size() > 0 && incoming().promptTitle.size() <= 150
          && incoming().promptCategory is string && incoming().promptCategory.size() <= 50
          && incoming().promptAuthorUid is string && incoming().promptAuthorUid.size() <= 128
          && incoming().promptAuthorName is string && incoming().promptAuthorName.size() > 0 && incoming().promptAuthorName.size() <= 200
          && incoming().createdAt == request.time
          && incoming().keys().hasOnly(['promptId', 'promptTitle', 'promptCategory', 'promptAuthorUid', 'promptAuthorName', 'createdAt']);

        allow update: if false;

        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /folders/{folderId} {
      allow list: if resource.data.isShared == true || isFounder() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
      allow get: if isFounder() || (isSignedIn() && existing().userId == request.auth.uid) || (existing().isShared == true);
      
      allow create: if isSignedIn()
        && isValidId(folderId)
        && incoming().userId == request.auth.uid
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100
        && (!('description' in incoming()) || (incoming().description is string && incoming().description.size() <= 500))
        && (!('isShared' in incoming()) || incoming().isShared is bool)
        && (!('authorName' in incoming()) || (incoming().authorName is string && incoming().authorName.size() <= 200))
        && (!('authorHandle' in incoming()) || (incoming().authorHandle is string && incoming().authorHandle.size() <= 40))
        && incoming().createdAt == request.time;
        
      allow update: if isSignedIn()
        && isValidId(folderId)
        && existing().userId == request.auth.uid
        && incoming().userId == request.auth.uid
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100
        && (!('description' in incoming()) || (incoming().description is string && incoming().description.size() <= 500))
        && (!('isShared' in incoming()) || incoming().isShared is bool)
        && (!('authorName' in incoming()) || (incoming().authorName is string && incoming().authorName.size() <= 200))
        && (!('authorHandle' in incoming()) || (incoming().authorHandle is string && incoming().authorHandle.size() <= 40))
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'isShared', 'authorName', 'authorHandle']);
    }

    match /prompts/{promptId} {
      // Secure list query and document retrieve (allow authenticated owner or explicitly shared prompt)
      allow get: if isFounder()
        || (existing().isShared == true) 
        || (isSignedIn() && existing().userId == request.auth.uid);
        
      allow list: if isFounder()
        || (existing().isShared == true) 
        || (isSignedIn() && existing().userId == request.auth.uid);
      
      // Strict creation verification
      allow create: if isSignedIn() 
        && isValidId(promptId) 
        && isValidPrompt(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
        
      // Strict update matching (Tiered: Owner edit OR Community global social Like)
      allow update: if isSignedIn()
        && isValidId(promptId)
        && (
          // Case 1: Owner-authorized edit
          (existing().userId == request.auth.uid
            && incoming().userId == request.auth.uid
            && isValidPrompt(incoming())
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'promptText', 'category', 'tags', 'isFavorite', 'notas', 'suggestedVariables', 'isShared', 'authorName', 'authorAvatar', 'authorHandle', 'forkedFrom', 'forkedFromPromptId', 'forkedFromUserId', 'forkedFromAuthorName', 'forkedFromAuthorHandle', 'forkedFromTitle', 'updatedAt', 'folderId']))
          ||
          // Case 2: Non-owner social interaction (liking/unliking shared prompts)
          (existing().isShared == true
            // Enforce immutability of other core fields to prevent injection
            && incoming().userId == existing().userId
            && incoming().title == existing().title
            && incoming().promptText == existing().promptText
            && incoming().category == existing().category
            && incoming().isShared == existing().isShared
            && incoming().createdAt == existing().createdAt
            && incoming().diff(existing()).affectedKeys().hasOnly(['likedBy', 'likesCount', 'updatedAt'])
            && incoming().likedBy is list
            && incoming().likedBy.size() <= 1000
            && incoming().likesCount is int
            && incoming().likesCount == incoming().likedBy.size()
            && (
              (
                !('likedBy' in existing())
                && request.auth.uid in incoming().likedBy
                && incoming().likedBy.size() == 1
              )
              ||
              (
                'likedBy' in existing()
                && !(request.auth.uid in existing().likedBy)
                && request.auth.uid in incoming().likedBy
                && incoming().likedBy.size() == existing().likedBy.size() + 1
                && incoming().likedBy.hasAll(existing().likedBy)
              )
              ||
              (
                'likedBy' in existing()
                && request.auth.uid in existing().likedBy
                && !(request.auth.uid in incoming().likedBy)
                && incoming().likedBy.size() == existing().likedBy.size() - 1
                && existing().likedBy.hasAll(incoming().likedBy)
              )
            ))
        );
        
      // Strictly deletion
      allow delete: if isSignedIn()
        && existing().userId == request.auth.uid;

      // Subcollection for comments
      match /comments/{commentId} {
        allow list, get: if (get(/databases/$(database)/documents/prompts/$(promptId)).data.isShared == true)
          || (isSignedIn() && get(/databases/$(database)/documents/prompts/$(promptId)).data.userId == request.auth.uid);

        allow create: if isSignedIn()
          && isValidId(commentId)
          && (get(/databases/$(database)/documents/prompts/$(promptId)).data.userId == request.auth.uid
              || get(/databases/$(database)/documents/prompts/$(promptId)).data.isShared == true)
          && incoming().userId == request.auth.uid
          && incoming().userName is string && incoming().userName.size() <= 200
          && (!('userAvatar' in incoming()) || (incoming().userAvatar is string && incoming().userAvatar.size() <= 1000))
          && incoming().text is string && incoming().text.size() > 0 && incoming().text.size() <= 1000
          && incoming().createdAt == request.time;

        allow delete: if isSignedIn()
          && (existing().userId == request.auth.uid
              || get(/databases/$(database)/documents/prompts/$(promptId)).data.userId == request.auth.uid);
      }

      match /reports/{reporterId} {
        allow get, list: if isSignedIn()
          && (
            isFounder()
            || get(/databases/$(database)/documents/prompts/$(promptId)).data.userId == request.auth.uid
          );

        allow create: if isSignedIn()
          && reporterId == request.auth.uid
          && get(/databases/$(database)/documents/prompts/$(promptId)).data.isShared == true
          && get(/databases/$(database)/documents/prompts/$(promptId)).data.userId != request.auth.uid
          && incoming().reporterUid == request.auth.uid
          && incoming().reason is string && incoming().reason.size() > 0 && incoming().reason.size() <= 80
          && incoming().promptTitle == get(/databases/$(database)/documents/prompts/$(promptId)).data.title
          && incoming().promptAuthorUid == get(/databases/$(database)/documents/prompts/$(promptId)).data.userId
          && incoming().createdAt == request.time
          && incoming().keys().hasOnly(['reporterUid', 'reason', 'promptTitle', 'promptAuthorUid', 'createdAt']);

        allow update, delete: if false;
      }

      // Subcollection for version history
      match /versions/{versionId} {
        allow get: if isSignedIn() && get(/databases/$(database)/documents/prompts/$(promptId)).data.userId == request.auth.uid;
        allow list: if isSignedIn() && get(/databases/$(database)/documents/prompts/$(promptId)).data.userId == request.auth.uid;
        
        allow create: if isSignedIn()
          && get(/databases/$(database)/documents/prompts/$(promptId)).data.userId == request.auth.uid
          && isValidId(versionId)
          && incoming().promptText is string && incoming().promptText.size() > 0 && incoming().promptText.size() <= 10000
          && incoming().createdAt == request.time;
          
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/prompts/$(promptId)).data.userId == request.auth.uid;
      }
    }
  }
}
