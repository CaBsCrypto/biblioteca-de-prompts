# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional. Defaults to the current stable Flash model used by the server.
GEMINI_MODEL="gemini-2.5-flash"

# OPENROUTER_API_KEY: Optional. Enables multi-model support (Claude, GPT-4o, Mistral, etc.)
# Get your key at https://openrouter.ai/keys
# When set, a model selector dropdown appears in the AI panels.
OPENROUTER_API_KEY=""

# GNEWS_API_KEY: Optional. Enables premium news sources via GNews API.
GNEWS_API_KEY=""

# AI_RATE_LIMIT_*: Optional guardrails for AI endpoints.
AI_RATE_LIMIT_WINDOW_MS="600000"
AI_RATE_LIMIT_MAX="20"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Local browser verification only. Ignored in production builds.
VITE_FIREBASE_EMULATORS="false"

# Public listing. Set only after verifying Biblioteca's published directory URL.
# VITE_BIBLIOTECA_CHATGPT_LISTING_URL=
# Dedicated MCP widget origin supplied for the reviewed plugin.
# BIBLIOTECA_WIDGET_DOMAIN=

# Guest transfers and the personal ChatGPT library are independently staged.
BIBLIOTECA_PROMPT_TRANSFERS_ENABLED="false"
BIBLIOTECA_PERSONAL_LIBRARY_ENABLED="false"
# Shared pilot quota and saved library. Enable backend and Preview web build together.
BIBLIOTECA_LIBRARY_BETA_ENABLED="false"
VITE_BIBLIOTECA_LIBRARY_BETA_ENABLED="false"
# Server-only Firebase Admin credential. Omit to use Application Default Credentials.
# BIBLIOTECA_FIREBASE_ADMIN_CREDENTIALS=
# Preview usa un proyecto Firebase separado con Firestore (default).
# VITE_BIBLIOTECA_PILOT_FIREBASE_CONFIG=
# BIBLIOTECA_PILOT_FIREBASE_PROJECT_ID=
# BIBLIOTECA_PILOT_GCP_AUDIENCE=//iam.googleapis.com/projects/NUMBER/locations/global/workloadIdentityPools/POOL/providers/PROVIDER
# BIBLIOTECA_PILOT_GCP_SERVICE_ACCOUNT=
# Both emulator addresses are required together in local development.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# OAuth pilot configuration. The callback URI must match the one from ChatGPT.
# Set VERCEL Preview's issuer to vercel-preview to use its exact deployment hostname.
# BIBLIOTECA_OAUTH_ISSUER=https://biblioteca.browns.studio/api/biblioteca-oauth
# BIBLIOTECA_OAUTH_REDIRECT_URI=
# BIBLIOTECA_OAUTH_COOKIE_KEYS=
# BIBLIOTECA_OAUTH_JWKS=

# Web-only Pro checkout. This version accepts test_mode only.
BIBLIOTECA_BILLING_ENABLED="false"
BIBLIOTECA_DODO_ENVIRONMENT="test_mode"
# BIBLIOTECA_BILLING_ORIGIN=
# BIBLIOTECA_BILLING_CODE_SECRET=
# DODO_PAYMENTS_API_KEY=
# DODO_PAYMENTS_WEBHOOK_KEY=
# BIBLIOTECA_DODO_BUSINESS_ID=
# BIBLIOTECA_DODO_MONTHLY_PRODUCT_ID=
# BIBLIOTECA_DODO_PREPAID_PRODUCT_ID=
