# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional. Defaults to the current stable Flash model used by the server.
GEMINI_MODEL="gemini-2.5-flash"

# OPENROUTER_API_KEY: Optional. Enables multi-model support (Claude, GPT-4o, Mistral, etc.)
# Get your key at https://openrouter.ai/keys
# When set, a model selector dropdown appears in the AI panels.
OPENROUTER_API_KEY=""

# GNEWS_API_KEY: Optional. Enables premium news sources via GNews API.
GNEWS_API_KEY=""

# AI_RATE_LIMIT_*: Optional guardrails for AI endpoints.
AI_RATE_LIMIT_WINDOW_MS="600000"
AI_RATE_LIMIT_MAX="20"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
