{
  "name": "biblioteca-de-prompts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node scripts/build-mcp-ui.mjs && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "qa": "npm run lint && npm run build",
    "qa:vercel": "npm run qa",
    "smoke:vercel": "node scripts/smoke-vercel.mjs",
    "test:rules": "firebase emulators:exec --config firebase.emulators.json --project demo-biblioteca --only firestore \"vitest run tests/firestore.rules.test.ts tests/catalog.rules.test.ts\"",
    "test:unit": "vitest run tests/catalog.test.ts tests/router.test.ts tests/mcp.catalog.test.ts tests/mcp.server.test.ts tests/mcp.widget.test.ts tests/plugin-package.test.ts",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "package:plugin": "node scripts/package-plugin.mjs",
    "verify:server-startup": "node scripts/verify-server-startup.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openai/mcp-extensions": "^0.1.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "firebase": "^12.14.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-tools": "^15.20.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.8"
  }
}
